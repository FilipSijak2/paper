# Environment variables for robot system
# Copy this file to .env and modify values as needed

# Database configuration
POSTGRES_DB=robot_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ROS2 configuration
ROS_DOMAIN_ID=0

# File paths
MAP_ROOT=/srv/maps

# Network ports
ROSBRIDGE_PORT=9090

# Serial device configuration
# Arduino R4 WiFi micro-ROS communication
MICROROS_DEVICE=/dev/ttyACM0
MICROROS_BAUDRATE=115200

# LIDAR configuration (optional)
LASER_PORT=/dev/ttyUSB0
LASER_BAUDRATE=230400

# Display for GUI applications (Linux)
DISPLAY=:0

# Container registry (for CI/CD)
REGISTRY_HOST=your-registry-host:5000
REGISTRY_USER=your-username
REGISTRY_PASS=your-password

# Docker image tags
SLAM_TAG=latest
NAV_TAG=latest
SENSOR_FUSION_TAG=latest
ROSBRIDGE_TAG=latest
DB_TAG=latest